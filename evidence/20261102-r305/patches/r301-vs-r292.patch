+    def _warm_thinker_graphs(self, batches: list[int]) -> None:
+        """Capture bounded configured shapes before health-ready, with inert KV.
+
+        No request, data-dependent token or RNG state is used. All dummy pages
+        are drained before release and every real replay rebinds its inputs.
+        Startup cost is reported separately from native service timers.
+        """
+        import time
+
+        if not self.trun.use_graphs:
+            return
+        shapes = sorted(set(int(batch) for batch in batches))
+        if any(batch < 1 or batch > self.trun.graph_max_batch for batch in shapes):
+            raise ValueError("Thinker warmup batches exceed graph capacity")
+        with torch.inference_mode():
+            for batch in shapes:
+                seqs = [-20_000 - index for index in range(batch)]
+                if not self.tkv.can_fit({seq: 1 for seq in seqs}):
+                    continue
+                started = time.perf_counter()
+                try:
+                    for seq in seqs:
+                        self.tkv.reserve(seq, 1)
+                    layout = self.tkv.layout(seqs, [1] * batch)
+                    inputs = torch.zeros(batch, self.tspec.hidden_size,
+                                         dtype=self.thinker.dtype, device=self.device)
+                    self.trun.forward(inputs, layout)
+                    torch.npu.synchronize()
+                    self.thinker_graph_warmup_s[batch] = time.perf_counter() - started
+                finally:
+                    torch.npu.synchronize()
+                    for seq in seqs:
+                        if seq in self.tkv.pages:
+                            self.tkv.release(seq)
 
