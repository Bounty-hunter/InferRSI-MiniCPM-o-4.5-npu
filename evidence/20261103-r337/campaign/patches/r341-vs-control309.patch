--- a/engine/runtime/script_elementwise.py
+++ b/engine/runtime/script_elementwise.py
@@ -0,0 +1,27 @@
+"""Small reference-rounding chains executed by the C++ JIT interpreter.
+
+No lowered precision, tensor-expression fusion, or accelerator-specific
+approximation is requested. Exact operator probes and Thinker parity are
+required before native timing; unsupported scripting is a rejected attempt.
+"""
+import torch
+import torch.nn.functional as F
+
+@torch.jit.script
+def rms(x: torch.Tensor, weight: torch.Tensor, eps: float) -> torch.Tensor:
+    xf = x.float()
+    return weight * (xf * torch.rsqrt(xf.pow(2).mean(-1, keepdim=True) + eps)).to(x.dtype)
+
+@torch.jit.script
+def rotate(x: torch.Tensor) -> torch.Tensor:
+    d = x.shape[-1]
+    return torch.cat([-x[..., d // 2:], x[..., :d // 2]], dim=-1)
+
+@torch.jit.script
+def rope(q: torch.Tensor, k: torch.Tensor, cos: torch.Tensor, sin: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    return q * cos + rotate(q) * sin, k * cos + rotate(k) * sin
+
+@torch.jit.script
+def silu_mul(gate_up: torch.Tensor) -> torch.Tensor:
+    gate, up = gate_up.chunk(2, dim=-1)
+    return F.silu(gate) * up
