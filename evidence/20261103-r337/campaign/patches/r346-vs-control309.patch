+"""Standalone use of the same rotary operator seen in Ascend Qwen2.
+
+The fused arithmetic may have different intermediate rounding; it is not
+bitwise-qualified by construction and requires the existing quality gates.
+"""
+def apply(query,key,tables):
+    import torch_npu
+    cos,sin=tables
+    cosine,sine=cos.unsqueeze(0),sin.unsqueeze(0)
+    return (torch_npu.npu_rotary_mul(query.unsqueeze(0),cosine,sine).squeeze(0),
+            torch_npu.npu_rotary_mul(key.unsqueeze(0),cosine,sine).squeeze(0))
