+        rotated = torch.cat([-combined[..., d // 2:], combined[..., :d // 2]], dim=-1)
+        result = combined * cos + rotated * sin
+        self.packed_rotary_host_calls += 1
+        return result[:, :heads].contiguous(), result[:, heads:].contiguous()
