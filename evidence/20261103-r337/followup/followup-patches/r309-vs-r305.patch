+        torch.npu.synchronize()
+        record = {"owner": "EulerGraphs", "key": [rows, frames, cache], "lane": lane, "seconds": time.perf_counter() - then}
+        self.t2w_startup_stats["keys"].append(record)
+        print({"media_graph_startup": record}, flush=True)
